# Site Configuration
NEXT_PUBLIC_SITE_URL=https://jtfenceboston.com
NEXT_PUBLIC_COMPANY_NAME=JT Fence Inc.
NEXT_PUBLIC_PHONE=(617) 555-0123
NEXT_PUBLIC_EMAIL=info@jtfenceboston.com

# Analytics (optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Contact form — use ONE of the following (Resend is typical for Vercel):

# Option A — Resend (resend.com): verify your domain, then:
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="JT Fence <contact@jtfenceboston.com>"

# Option B — Gmail SMTP (App Password: Google Account → Security → 2-Step Verification → App passwords)
# GMAIL_USER=jtfenceboston@gmail.com
# GMAIL_APP_PASSWORD=

# Optional: override inbox (defaults to jtfenceboston@gmail.com)
# CONTACT_TO_EMAIL=jtfenceboston@gmail.com
